#include <iostream>
using namespace std;

int main() {
    int n;

    // Ask for the number of elements
    cout << "Enter number of elements: ";
    cin >> n;

    // Validate size
    if (n <= 0){

        cout << "Invalid size. Must be greater than 0.\n";
        return 1;
    }

    int arr[n]; // Declare array of size n

    // Take input from user
    cout << "Enter " << n << " integers:\n";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    // Display the array
    cout << "You entered: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    return 0;
}
